# ============================================================
#  העתק קובץ זה ל-.env.local ומלא את הערכים
# ============================================================

# --- חובה (גם לבדיקה ב-Playground) ---
# מפתח Anthropic API. השג מ-https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# אופציונלי - לשנות מודל. ברירת מחדל: claude-sonnet-4-6 (עברית נקייה ללקוחות).
# לזול יותר: claude-haiku-4-5-20251001
# CHATBOT_MODEL=claude-sonnet-4-6

# --- תמלול הודעות קוליות (אופציונלי) ---
# מפתח OpenAI לתמלול הודעות קוליות (Whisper). השג מ-https://platform.openai.com
# אם ריק - הבוט יבקש מהלקוח להקליד במקום הודעה קולית.
# OPENAI_API_KEY=sk-...

# --- בסיס נתונים (פרודקשן) ---
# מוגדר אוטומטית ע"י Neon ב-Vercel. מקומית - השאר ריק (משתמש באחסון קובץ).
# DATABASE_URL=

# --- פאנל ניהול ---
# טוקן להגנת /admin. בפרודקשן חובה להגדיר.
# ADMIN_TOKEN=

# --- אבטחת webhooks של Meta (מומלץ בפרודקשן) ---
# App Secret מ-Meta App Dashboard > Settings > Basic. מאמת שה-webhook באמת מ-Meta.
# META_APP_SECRET=

# --- WhatsApp (Meta) ---
# מחרוזת שאתה ממציא, תזין אותה גם בהגדרת ה-webhook במטא
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
# מ-Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Messenger (Meta) ---
MESSENGER_VERIFY_TOKEN=my-messenger-verify-token
MESSENGER_PAGE_ACCESS_TOKEN=

# --- Instagram (Meta) ---
INSTAGRAM_VERIFY_TOKEN=my-instagram-verify-token
# טוקן העמוד המקושר לאינסטגרם (יכול להיות זהה ל-MESSENGER אם אותו עמוד)
INSTAGRAM_PAGE_ACCESS_TOKEN=

# --- שער החניה (PalGate) - אופציונלי ---
# פתיחת שער החניה מהצ'אט. הפק את הערכים עם: node scripts/palgate-link.mjs
# (סריקת QR חד-פעמית מאפליקציית PalGate: תפריט > Linked Devices > Link a Device).
# כשהמשתנים ריקים - היכולת כבויה לגמרי והבוט לא מציע אותה.
# PALGATE_SESSION_TOKEN=
# PALGATE_PHONE=9725xxxxxxxx
# PALGATE_TOKEN_TYPE=1
# PALGATE_DEVICE_ID=
# מתג הקמה זמני: עוקף את בדיקת שעות הפעילות (לבדיקה פיזית מול השער, גם בסופ"ש).
# ⚠️ כשדלוק - השער נפתח לכל בקשה בכל שעה. לכבות/למחוק אחרי שמאמתים שהכל עובד!
# PALGATE_IGNORE_HOURS=1
