/**
 * בדיקות לשער ההזמנה לביקורת (src/lib/review-invite.ts).
 *
 * הדרישה: לשלוח **רק** למי שאמר במפורש שהיה ושנהנה, ובספק - לא לשלוח.
 * לכן רוב הבדיקות כאן הן על מה שאסור לשלוח, ולא על מה שמותר.
 *
 * הרצה: npx tsx scripts/review-invite-test.mts   (חינם)
 */
import { shouldInviteReview, reviewInviteLine, REVIEW_INVITE_VARIANTS } from "../src/lib/review-invite";

let pass = 0;
const fails: string[] = [];
const yes = (text: string, extra = {}) => {
  if (shouldInviteReview({ text, ...extra })) pass++;
  else fails.push(`היה צריך לשלוח ולא נשלח:  "${text}"`);
};
const no = (text: string, extra = {}) => {
  if (!shouldInviteReview({ text, ...extra })) pass++;
  else fails.push(`נשלח ולא היה צריך:  "${text}"`);
};

// ===== כן: ביקור מפורש + שבח מפורש =====
yes("היינו אצלכם אתמול והיה מושלם");
yes("אכלנו אצלכם בשישי, היה ממש טעים");
yes("ביקרנו אתמול בערב ונהנינו מאוד");
yes("היינו בשבת והיה כיף");
yes("הייתי אצלכם היום, האוכל מדהים");
yes("ישבנו אצלכם אתמול, שירות מעולה");
yes("חגגנו אצלכם יום הולדת והיה מהמם");
yes("באנו אתמול ואהבנו הכל");
yes("טעמנו את הקינוחים אצלכם אתמול, תענוג");
yes("הגענו אתמול בערב, אין מילים");
yes("בילינו אצלכם אתמול, כל הכבוד לצוות");

// ===== לא: המלכודת הנפוצה ביותר - בקשה עתידית בלשון עבר =====
no("הייתי רוצה להזמין מקום לשבת");
no("היינו רוצים לשריין שולחן לשניים");
no("הייתי שמח לדעת מה השעות שלכם");
no("רצינו להזמין לשישי");
no("היינו מעוניינים בהזמנה לערב");

// ===== לא: ביקור בלי שבח =====
no("היינו אצלכם אתמול");
no("אכלנו אצלכם בשבוע שעבר");

// ===== לא: שבח בלי ביקור =====
no("מעולה תודה");
no("מושלם");
no("אחלה, תודה רבה");
no("נשמע טעים");
no("שמעתי שאתם מדהימים");

// ===== לא: ביקורת שלילית או מסויגת =====
no("היינו אצלכם אתמול והיה גרוע");
no("אכלנו אצלכם והאוכל היה קר מדי");
no("היינו אצלכם, היה טעים אבל יקר מדי");
no("ביקרנו אתמול, האוכל מעולה אבל השירות היה איטי");
no("היינו אצלכם אתמול והיה טעים, חבל שחיכינו הרבה");
no("היינו אצלכם, היה מעולה למרות ההמתנה");
no("אכלנו אצלכם והיה נחמד, לצערי הפסקנו באמצע");
no("הייתי אצלכם אתמול, רוצה להתלונן על משהו");

// ===== לא: שאלה או בקשה, גם כשיש שבח =====
no("היינו אצלכם אתמול והיה מדהים, אפשר להזמין לשבת?");
no("אכלנו אצלכם והיה טעים, מה השעות שלכם היום?");
no("היינו אצלכם והיה מושלם, כמה עולה ארוחת בוקר?");
no("ביקרנו אתמול, היה מעולה. אפשר לשריין לשבוע הבא");

// ===== לא: כבר הוזמן, או שהשיחה אצל נציג =====
no("היינו אצלכם אתמול והיה מושלם", { alreadyInvited: true });
no("היינו אצלכם אתמול והיה מושלם", { escalated: true });

// ===== לא: תלונה מוקדמת יותר באותה שיחה =====
no("היינו אצלכם אתמול והיה מעולה", { episodeText: "רציתי להתלונן על ההזמנה שלי מאתמול" });

// ===== לא: הודעה ארוכה מדי (כמעט תמיד יש בה גם משהו אחר) =====
no("היינו אצלכם אתמול והיה מושלם. " + "ועוד המון פרטים על הערב שהיה לנו ועל כל מה שקרה בו. ".repeat(12));

// ===== אותיות שימוש מחוברות =====
yes("שהיינו אצלכם אתמול היה מדהים");
yes("וביקרנו אצלכם בשישי, ממש נהנינו");

// ===== מקרי קצה נוספים מהשטח =====
yes("ביקרנו אצלכם אתמול והיה נורא טעים");   // "נורא" כמילת הגברה, לא תלונה
no("היינו אצלכם אתמול והיה נורא");          // ואותה מילה כתלונה
no("היינו אצלכם אתמול ושכחנו מעיל");         // ביקור בלי שבח
no("שלום, מתי אתם פותחים?");
no("נשמע מדהים, אני אגיע");                  // שבח על תיאור, לא על ביקור
no("חברים שלי היו אצלכם ואמרו שמעולה");      // עדות מכלי שני
no("היינו צריכים להזמין מראש?");
yes("אכלנו אצלכם אתמול, הפיצה מושלמת");
yes("היינו אצלכם בערב ונהנינו מכל רגע");
no("היה לנו מקרה לא נעים אצלכם אתמול");

// ===== נוסח ההזמנה =====
const URL = "https://example.com/review";
t("הקישור מופיע בשורה נפרדת", reviewInviteLine(URL, 0).endsWith(`\n${URL}`), true);
t("הנוסח הראשון", reviewInviteLine(URL, 0).startsWith(REVIEW_INVITE_VARIANTS[0]), true);
t("הנוסח האחרון", reviewInviteLine(URL, 0.99).startsWith(REVIEW_INVITE_VARIANTS[2]), true);
t("אין מקף ארוך בנוסחים", REVIEW_INVITE_VARIANTS.every((v) => !v.includes("—")), true);
t("כל הנוסחים שונים", new Set(REVIEW_INVITE_VARIANTS).size, REVIEW_INVITE_VARIANTS.length);

function t(name: string, got: unknown, want: unknown) {
  if (JSON.stringify(got) === JSON.stringify(want)) pass++;
  else fails.push(`${name}\n     קיבלנו: ${JSON.stringify(got)}  ציפינו: ${JSON.stringify(want)}`);
}

if (fails.length) {
  console.log(`\n${fails.length} נכשלו:\n`);
  for (const f of fails) console.log(`  ❌ ${f}`);
  console.log("");
}
console.log(`${pass} עברו, ${fails.length} נכשלו`);
process.exit(fails.length ? 1 : 0);
